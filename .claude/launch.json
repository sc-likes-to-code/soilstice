{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "soilstice-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "soilstice-web-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100,
      "env": {
        "NEXT_PUBLIC_DATA_MODE": "api",
        "NEXT_PUBLIC_API_BASE_URL": "http://localhost:8000/api/v1"
      }
    },
    {
      "name": "soilstice-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "soilstice-web-existing",
      "url": "http://localhost:3000"
    }
  ]
}
