{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOILSTICE Backend Crop Knowledge Base Schema",
  "description": "Standardized, versioned JSON Schema governing the canonical 14 SOILSTICE crop entities, agronomic data domains, physiological disaggregations, and attribute-level evidence metadata.",
  "version": "1.1.0-RECONCILED",
  "type": "object",
  "required": [
    "metadata",
    "crops",
    "evidence_registry"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "dataset_name",
        "schema_version",
        "stage",
        "effective_date",
        "geographic_scope",
        "canonical_crop_count",
        "evidence_records_count",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "dataset_name": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "effective_date": {
          "type": "string"
        },
        "geographic_scope": {
          "type": "string"
        },
        "canonical_crop_count": {
          "type": "integer",
          "enum": [
            14
          ]
        },
        "evidence_records_count": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "last_updated": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "crops": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/CropEntity"
      }
    },
    "evidence_registry": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceRecord"
      }
    }
  },
