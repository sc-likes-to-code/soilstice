# SOILSTICE backend configuration — copy to backend/.env (git-ignored). All variables are optional except where noted.

# SOILSTICE_ENVIRONMENT=development
# SOILSTICE_LOG_LEVEL=INFO
# SOILSTICE_LOG_FORMAT=json            # json | text

# Storage (SQLite document store for Phase 2; PostGIS is the target, see db/schema.sql)
# SOILSTICE_DB_PATH=.data/soilstice.sqlite3
# SOILSTICE_CACHE_DIR=.cache           # immutable raw upstream cache (CDL county GeoTIFFs ~4 MB/year/county)

# SOILSTICE_CORS_ORIGINS=["http://localhost:3000","http://localhost:3100","http://localhost:3101"]
# SOILSTICE_RATE_LIMIT_WRITES_PER_MINUTE=60

# Processing
# SOILSTICE_JOB_EXECUTION=thread       # thread | inline
# SOILSTICE_JOB_WORKERS=2
# SOILSTICE_HTTP_RETRIES=3
# SOILSTICE_HTTP_BACKOFF_BASE_S=2.0
# SOILSTICE_HTTP_TIMEOUT_S=60
# SOILSTICE_HTTP_DOWNLOAD_TIMEOUT_S=300
# SOILSTICE_CDL_FIRST_YEAR=2006
# SOILSTICE_CDL_LAST_YEAR=2025
# SOILSTICE_CDL_PARALLEL_REQUESTS=1    # CropScape times out under parallel load
# SOILSTICE_CLIMATE_DEFAULT_SEASON_YEAR=  # default: previous calendar year

# Meteomatics API Credentials — REQUIRED for Soil Moisture (4 depths), Elevation, Conditional Slope, and Regional NDVI.
# Insert your credentials into backend/.env (never commit real values).
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# NASA Earthdata Login — Legacy provider for SRTM terrain / HLS / SMAP. No longer in critical execution path.
# Either a bearer token (https://urs.earthdata.nasa.gov/ → Generate Token)...
# SOILSTICE_EARTHDATA_TOKEN=
# ...or a username + password pair (basic auth is only ever sent to urs.earthdata.nasa.gov)
# SOILSTICE_EARTHDATA_USERNAME=
# SOILSTICE_EARTHDATA_PASSWORD=

# Crop knowledge base (teammate deliverable). Directory containing kb.json; every threshold must be cited.
# SOILSTICE_CROP_KB_DIR=
