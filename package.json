{
  "name": "soilstice-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contract:openapi": "node contract/export-openapi.mjs",
    "contract:gen": "openapi-typescript backend/openapi.json -o contract/openapi.gen.ts",
    "contract:check": "npm run contract:gen && tsc -p contract",
    "contract:fixtures": "node contract/export-fixtures.mjs",
    "diagnostics:environment": "node scripts/run-diagnostics.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.72.0",
    "maplibre-gl": "^5.24.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
